 "findings": [
  {
   "item": "G4",
   "level": "미반영",
   "article": "제92조",
   "quote": "제2항제2호에 따라 위촉된 위원을 최소 2명 이상 포함할 것",
   "law": "사립학교법 제62조제4항제2호",
   "law_quote": "외부위원은 해당 학교법인 또는 사립학교경영자가 설치ㆍ경영하는 학교에 소속된 사람이 아닐 것",
   "issue": "징계위원회 구성 기준 — 외부위원 소속 제한(법인 설치 학교 소속 아님)과 이사 위원 2분의 1 이하 기준 없음",
   "fix": "제3항에 외부위원 소속 제한·이사 위원 비율 기준 추가"
  },
  {
   "item": "H3",
   "level": "확인필요",
   "article": "제119조",
   "quote": "임용권자가 공개채용, 전형 또는 근무성적 기타 능력의 실증에 의하여 행함을 원칙으로 한다",
   "law": "사립학교법 제70조의3제1항",
   "law_quote": "소속 사무직원을 신규채용하는 경우 공개전형에 의하도록 하며",
   "issue": "사무직원 신규채용 방법 — '공개채용, 전형 또는' 병렬 표기로 비공개 전형 여지, 공개전형 의무 명시 여부 확인 필요",
   "fix": "신규채용은 공개전형으로 한다는 문구 명시"
  },
  {
   "item": "I3",
   "level": "정비",
   "article": "제75조",
   "quote": "필요한 사항은 「사립학교법 시행령」제2    4조의6으로 정한다",
   "law": "사립학교법 시행령 제24조의9",
   "law_quote": "육아 등의 사유로 휴직하는 교원의 신분 및 처우",
   "issue": "인용 조문 오류 — 영 제24조의6은 교육공무원의 파견근무, 육아휴직자 신분·처우는 영 제24조의9",
   "fix": "'사립학교법 시행령 제24조의9'로 정비"
  }
 ],
