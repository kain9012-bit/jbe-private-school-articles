 "findings": [
  {
   "item": "B14",
   "level": "확인필요",
   "article": "제26조3",
   "quote": "상임이사는 예산의 범위내에서 수당을 지급할 수 있다",
   "law": "사립학교법 제26조제1항",
   "law_quote": "정관으로 정한 상근(常勤) 임원을 제외한 임원에게는 보수를 지급하지 아니한다",
   "issue": "상임이사 수당 지급 — 상근 임원 여부 규정 없음, 비상근이면 보수 금지 저촉 소지",
   "fix": "상임이사를 상근 임원으로 명시하거나 수당 규정 정비"
  },
  {
   "item": "I2",
   "level": "정비",
   "article": "제42조",
   "quote": "재심위원 회에 재십 을 칭 구할 수 있다",
   "law": "사립학교법 제54조의4제1항제3호",
   "law_quote": "교원소청심사위원회에 소청심사를 청구하여",
   "issue": "옛 기관명 '재심위원회·재심' — 현행 교원소청심사위원회·소청심사",
   "fix": "'교원소청심사위원회에 소청심사를 청구'로 정비"
  },
  {
   "item": "I4",
   "level": "정비",
   "article": "제35조의4",
   "quote": "제62조의 규징에 의한 교원징계위원회의 동의를 얻어야 한다",
   "law": "",
   "law_quote": "",
   "issue": "내부 인용 오류 — 법 조문번호(제62조) 그대로 옮김, 정관 제62조는 삭제 조문, 교원징계위원회는 제51조",
   "fix": "'제51조에 따른 교원징계위원회'로 정비"
  }
 ],
