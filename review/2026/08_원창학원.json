 "findings": [
  {
   "item": "F8",
   "level": "확인필요",
   "article": "제41조",
   "quote": "7의 3 불임·난임으로 인하여 장기간의 치료가 필요할 경우",
   "law": "사립학교법 제59조제1항제1호",
   "law_quote": "신체ㆍ정신상의 장애로 장기요양이 필요한 경우(불임ㆍ난임으로 인하여 장기간의 치료가 필요한 경우를 포함한다)",
   "issue": "불임·난임 휴직을 별도 호(제7호의3)로 두고 '본인 희망 시 의무휴직'으로 규정 — 법은 제1호에 포함한 직권 의무휴직, 차이 여부 확인 필요",
   "fix": "제1호에 불임·난임 괄호 추가, 제7호의3 삭제 검토"
  },
  {
   "item": "F8",
   "level": "확인필요",
   "article": "제41조",
   "quote": "13. 기타 임용권자가 인정하는 사유가 있을 때",
   "law": "사립학교법 제59조제1항제13호",
   "law_quote": "그 밖에 정관으로 정하는 사유가 있는 경우",
   "issue": "휴직 사유를 임용권자 재량 인정 사유로 개방 — 법은 '정관으로 정하는 사유'로 한정",
   "fix": "구체 사유를 정관에 열거하는 방식으로 개정 검토"
  },
  {
   "item": "I2",
   "level": "정비",
   "article": "제47조",
   "quote": "재심위원회에 재심을 청구 할 수 있다",
   "law": "사립학교법 제54조의4제1항제3호",
   "law_quote": "교원소청심사위원회에 소청심사를 청구하여",
   "issue": "옛 기관명 '재심위원회·재심' — 현행 교원소청심사위원회·소청심사",
   "fix": "「교원의 지위 향상 및 교육활동 보호를 위한 특별법」에 따른 교원소청심사위원회 소청심사로 정비"
  },
  {
